<mvc:View controllerName="com.luxasia.campaignmanagement.controller.developerGuide"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page id="developerGuidePage">
        <customHeader>
            <!-- Page header: breadcrumb as in the prototype (Back is in the app header) -->
            <OverflowToolbar class="campHeader">
                <Text text="{i18n>Crumb_Guide}" class="campCrumb" />
                <ToolbarSpacer />
            </OverflowToolbar>
        </customHeader>
        <content>
            <VBox class="campPage">
                <Title text="{i18n>Guide_Title}" titleStyle="H3" class="campPageTitle" />
                <Text text="{i18n>Guide_Lead}" class="campLead" />

                <!-- Application navigation -->
                <VBox class="campCard">
                    <Title text="{i18n>Guide_Navigation}" titleStyle="H5" class="campCardTitle" />
                    <HBox alignItems="Stretch" class="campGuideFlow">
                        <VBox class="campGuideStep">
                            <layoutData><FlexItemData growFactor="1" baseSize="0" /></layoutData>
                            <Text text="{i18n>Guide_Step_List}" class="campGuideStepTitle" />
                            <Text text="{i18n>Guide_Step_List_Sub}" class="campGuideStepSub" />
                        </VBox>
                        <core:Icon src="sap-icon://arrow-right" class="campGuideArrow">
                            <core:layoutData><FlexItemData alignSelf="Center" /></core:layoutData>
                        </core:Icon>
                        <VBox class="campGuideStep">
                            <layoutData><FlexItemData growFactor="1" baseSize="0" /></layoutData>
                            <Text text="{i18n>Guide_Step_Detail}" class="campGuideStepTitle" />
                            <Text text="{i18n>Guide_Step_Detail_Sub}" class="campGuideStepSub" />
                        </VBox>
                        <core:Icon src="sap-icon://arrow-right" class="campGuideArrow">
                            <core:layoutData><FlexItemData alignSelf="Center" /></core:layoutData>
                        </core:Icon>
                        <VBox class="campGuideStep">
                            <layoutData><FlexItemData growFactor="1" baseSize="0" /></layoutData>
                            <Text text="{i18n>Guide_Step_Pricing}" class="campGuideStepTitle" />
                            <Text text="{i18n>Guide_Step_Pricing_Sub}" class="campGuideStepSub" />
                        </VBox>
                        <core:Icon src="sap-icon://arrow-right" class="campGuideArrow">
                            <core:layoutData><FlexItemData alignSelf="Center" /></core:layoutData>
                        </core:Icon>
                        <VBox class="campGuideStep">
                            <layoutData><FlexItemData growFactor="1" baseSize="0" /></layoutData>
                            <Text text="{i18n>Guide_Step_Review}" class="campGuideStepTitle" />
                            <Text text="{i18n>Guide_Step_Review_Sub}" class="campGuideStepSub" />
                        </VBox>
                    </HBox>
                </VBox>

                <!-- OData service contracts (Campaign & Pricing Management API v1.0) -->
                <VBox class="campCard">
                    <Title text="{i18n>Guide_Services}" titleStyle="H5" class="campCardTitle" />
                    <Table inset="false">
                        <columns>
                            <Column><Text text="{i18n>Guide_Service}" /></Column>
                            <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>Guide_Operation}" /></Column>
                            <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>Guide_Purpose}" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <Text text="/luxasia/oDataV4/Campaigns" class="campCode" />
                                <Text text="GET" />
                                <Text text="{i18n>Guide_Svc_Campaign}" />
                            </ColumnListItem>
                            <ColumnListItem>
                                <Text text="ZSDGW_CE_APP_SRV/CampaignsdSet" class="campCode" />
                                <Text text="POST" />
                                <Text text="{i18n>Guide_Svc_Campaign_S4}" />
                            </ColumnListItem>
                            <ColumnListItem>
                                <Text text="/luxasia/oDataV4/ConditionTypes" class="campCode" />
                                <Text text="GET" />
                                <Text text="{i18n>Guide_Svc_Types}" />
                            </ColumnListItem>
                            <ColumnListItem>
                                <Text text="/luxasia/oDataV4/ConditionTypeKeyCombinations" class="campCode" />
                                <Text text="GET / PATCH" />
                                <Text text="{i18n>Guide_Svc_Config}" />
                            </ColumnListItem>
                            <ColumnListItem>
                                <Text text="/luxasia/oDataV4/CampaignPricingRecords" class="campCode" />
                                <Text text="GET / POST / PATCH / DELETE" />
                                <Text text="{i18n>Guide_Svc_Pricing}" />
                            </ColumnListItem>
                            <ColumnListItem>
                                <Text text="ZUI_CAMP_VALUEHELP" class="campCode" />
                                <Text text="GET" />
                                <Text text="{i18n>Guide_Svc_ValueHelp}" />
                            </ColumnListItem>
                        </items>
                    </Table>
                </VBox>

                <!-- Developer checkpoints -->
                <VBox class="campCard">
                    <Title text="{i18n>Guide_Checkpoints}" titleStyle="H5" class="campCardTitle" />
                    <Text text="{i18n>Guide_Check_1}" class="campGuideCheck" />
                    <Text text="{i18n>Guide_Check_2}" class="campGuideCheck" />
                    <Text text="{i18n>Guide_Check_3}" class="campGuideCheck" />
                    <Text text="{i18n>Guide_Check_4}" class="campGuideCheck" />
                    <Text text="{i18n>Guide_Check_5}" class="campGuideCheck" />
                    <Text text="{i18n>Guide_Check_6}" class="campGuideCheck" />
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
