<mvc:View controllerName="com.luxasia.campaignmanagement.controller.campaignList"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:fb="sap.ui.comp.filterbar">
    <Page id="campaignListPage" showHeader="false">
        <content>
            <!-- Page header: breadcrumb as in the prototype -->
            <OverflowToolbar class="campHeader">
                <Text text="{i18n>Crumb_Campaigns}" class="campCrumb" />
                <ToolbarSpacer />
                <Button icon="sap-icon://refresh" tooltip="{i18n>Camp_Refresh}" press="onSearch" type="Transparent" />
            </OverflowToolbar>
            <!-- Overview cards (prototype "Overview": campaign counts) -->
            <HBox wrap="Wrap" class="campKpiRow">
                <VBox class="campKpiCard">
                    <Label text="{i18n>Camp_Kpi_Total}" />
                    <Title text="{view>/counts/all}" titleStyle="H2" />
                </VBox>
                <VBox class="campKpiCard">
                    <Label text="{i18n>Camp_Kpi_Active}" />
                    <Title text="{view>/counts/Active}" titleStyle="H2" class="campKpiActive" />
                </VBox>
                <VBox class="campKpiCard">
                    <Label text="{i18n>Camp_Kpi_Upcoming}" />
                    <Title text="{view>/counts/Upcoming}" titleStyle="H2" class="campKpiUpcoming" />
                </VBox>
                <VBox class="campKpiCard">
                    <Label text="{i18n>Camp_Kpi_Expired}" />
                    <Title text="{view>/counts/Expired}" titleStyle="H2" class="campKpiExpired" />
                </VBox>
            </HBox>

            <fb:FilterBar id="campFilterBar" useToolbar="false" showClearOnFB="true" search="onSearch" clear="onClearFilters"
                class="sapUiResponsiveContentPadding">
                <fb:filterGroupItems>
                    <fb:FilterGroupItem name="campaign" label="{i18n>Camp_Filter_Campaign}" groupName="camp" visibleInFilterBar="true">
                        <fb:control>
                            <Input id="fltCampaign" placeholder="{i18n>Camp_Filter_Campaign_Placeholder}" submit="onSearch" />
                        </fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem name="country" label="{i18n>Camp_Country}" groupName="camp" visibleInFilterBar="true">
                        <fb:control>
                            <MultiComboBox id="fltCountry" items="{path: 'CampModel>/countries', sorter: {path: 'Landx'}}"
                                showSelectAll="true" placeholder="{i18n>Camp_All_Countries}">
                                <core:Item key="{CampModel>Land1}" text="{= ${CampModel>Land1} + ' ' + ${CampModel>Landx} }" />
                            </MultiComboBox>
                        </fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem name="createdBy" label="{i18n>Camp_Created_By}" groupName="camp" visibleInFilterBar="true">
                        <fb:control>
                            <Input id="fltCreatedBy" submit="onSearch" />
                        </fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem name="createdOn" label="{i18n>Camp_Created_On}" groupName="camp" visibleInFilterBar="true">
                        <fb:control>
                            <DateRangeSelection id="fltCreatedOn" displayFormat="dd-MM-yyyy" />
                        </fb:control>
                    </fb:FilterGroupItem>
                </fb:filterGroupItems>
            </fb:FilterBar>

            <IconTabBar id="campTabs" selectedKey="{view>/tab}" select="onTabSelect" expandable="false" class="sapUiResponsiveContentPadding">
                <items>
                    <IconTabFilter key="all" icon="sap-icon://marketing-campaign" text="{i18n>Camp_Tab_All}" count="{view>/counts/all}" />
                    <IconTabFilter key="Active" icon="sap-icon://complete" text="{i18n>Camp_Tab_Active}" count="{view>/counts/Active}" iconColor="Positive" />
                    <IconTabFilter key="Upcoming" icon="sap-icon://future" text="{i18n>Camp_Tab_Upcoming}" count="{view>/counts/Upcoming}" iconColor="Neutral" />
                    <IconTabFilter key="Expired" icon="sap-icon://past" text="{i18n>Camp_Tab_Expired}" count="{view>/counts/Expired}" iconColor="Negative" />
                    <IconTabFilter key="No Pricing" icon="sap-icon://lead" text="{i18n>Camp_Tab_NoPricing}" count="{view>/counts/NoPricing}" iconColor="Default" />
                </items>
                <content>
                    <Table id="campTable"
                        class="campTable"
                        inset="false"
                        alternateRowColors="true"
                        popinLayout="GridSmall"
                        sticky="HeaderToolbar,ColumnHeaders"
                        noDataText="{view>/noDataText}"
                        busy="{view>/busy}"
                        items="{path: 'CampModel>/campaigns'}">
                        <headerToolbar>
                            <OverflowToolbar class="campTableToolbar">
                                <Title text="{i18n>Camp_Campaigns}" titleStyle="H5" />
                                <Text text="{i18n>Camp_Shown_Of} {view>/shown} / {CampModel>/total}" class="campTableCount" />
                                <ToolbarSpacer />
                                <Button text="{i18n>Camp_Create}" icon="sap-icon://add" type="Emphasized" press="onCreate" />
                            </OverflowToolbar>
                        </headerToolbar>
                        <columns>
                            <Column width="26%"><Text text="{i18n>Camp_Campaign}" /></Column>
                            <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>Camp_Country}" /></Column>
                            <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>Camp_Created}" /></Column>
                            <Column minScreenWidth="Tablet" demandPopin="true" width="14rem"><Text text="{i18n>Camp_Pricing_Validity}" /></Column>
                            <Column width="9.5rem"><Text text="{i18n>Camp_Status}" /></Column>
                            <Column hAlign="End" width="12rem"><Text text="{i18n>Camp_Actions}" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem type="Inactive" vAlign="Middle">
                                <cells>
                                    <!-- Campaign: ID on top, description below -->
                                    <VBox>
                                        <Text text="{CampModel>id}" class="campCellId" />
                                        <Text text="{CampModel>description}" class="campCellSub" wrapping="true" />
                                    </VBox>
                                    <!-- Country: code badge + name -->
                                    <HBox alignItems="Center">
                                        <Text text="{CampModel>country}" class="campCountryBadge" />
                                        <Text text="{CampModel>countryName}" class="sapUiTinyMarginBegin" />
                                    </HBox>
                                    <!-- Created: date + user -->
                                    <VBox>
                                        <Text text="{path: 'CampModel>createdOn', formatter: '.formatDate'}" />
                                        <Text text="{path: 'CampModel>createdBy', formatter: '.formatCreatedBy'}" class="campCellSub" />
                                    </VBox>
                                    <!-- Pricing validity: date range, hint below (same layout as the other cells) -->
                                    <VBox>
                                        <Text text="{parts: ['CampModel>pricingFrom', 'CampModel>pricingTo', 'CampModel>pricingCount'], formatter: '.formatPricingValidity'}"
                                            visible="{= ${CampModel>pricingCount} > 0 }" wrapping="false" />
                                        <Text text="{parts: ['CampModel>status', 'CampModel>pricingTo', 'CampModel>pricingNextFrom', 'CampModel>pricingCount'], formatter: '.formatValidityHint'}"
                                            class="campCellSub" />
                                    </VBox>
                                    <!-- Status pill: coloured by status through the data-status attribute (style.css) -->
                                    <HBox alignItems="Center" class="campStatusPill">
                                        <customData>
                                            <core:CustomData key="status" value="{path: 'CampModel>status', formatter: '.formatStatusKey'}" writeToDom="true" />
                                        </customData>
                                        <core:Icon src="{path: 'CampModel>status', formatter: '.formatStatusIcon'}" class="campStatusIcon" />
                                        <Text text="{CampModel>status}" class="campStatusText" wrapping="false" />
                                    </HBox>
                                    <HBox justifyContent="End" alignItems="Center">
                                        <Button icon="sap-icon://show" type="Transparent" tooltip="{i18n>Camp_Display}" press="onDisplay" />
                                        <Button icon="sap-icon://edit" type="Transparent" tooltip="{i18n>Camp_Change}" press="onChange" />
                                        <Button text="{i18n>Camp_Pricing}" icon="sap-icon://lead" type="Ghost" press="onPricing" class="sapUiTinyMarginBegin" />
                                    </HBox>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                    <!-- API §4.1: next 20 campaigns ($top=20, $skip = rows read so far) -->
                    <HBox justifyContent="Center" visible="{CampModel>/hasMore}" class="sapUiSmallMarginTop">
                        <Button text="{i18n>Camp_More}" icon="sap-icon://drill-down" press="onMore" enabled="{= !${view>/busy} }" />
                    </HBox>
                </content>
            </IconTabBar>
        </content>
    </Page>
</mvc:View>
